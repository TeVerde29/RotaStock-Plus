{
  "name": "rotastock-plus",
  "version": "2.0.0",
  "description": "RotaStock Plus — Control de rotación FIFO (PEPS), 9 módulos, 100% offline, estado único JSON",
  "author": "Pedro Giovanni Ricra Figueroa",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "pe.edu.unu.rotastockplus",
    "productName": "RotaStockPlus",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RotaStockPlus",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "frontend/**/*",
      "!frontend/vendor/.gitkeep"
    ],
    "extraMetadata": {},
    "portable": {
      "artifactName": "RotaStockPlus.exe"
    }
  }
}
